void loadPresetIntoEditor(uint8_t index) {

  if (index >= STATUS_PRESET_COUNT) {
    return;
  }

  presetEditIndex = index;
  presetEditText = statusPresets[index].text;
  presetEditBorder = statusPresets[index].border;
  presetEditBackground = statusPresets[index].background;
}

void publishPresetEditorState() {

  if (!mqttClient.connected()) {
    return;
  }

  // Selected preset
  mqttClient.publish(
    MQTT_PRESET_SELECT_STATE,
    statusPresets[presetEditIndex].name.c_str(),
    true
  );

  // Text color
  String textColor =
    String(presetEditText.r) + "," +
    String(presetEditText.g) + "," +
    String(presetEditText.b);

  mqttClient.publish(
    MQTT_PRESET_TEXT_COLOR_STATE,
    textColor.c_str(),
    true
  );

  mqttClient.publish(
    "office/sign/preset/state/text_color_power",
    "ON",
    true
  );

  // Border color
  String borderColor =
    String(presetEditBorder.r) + "," +
    String(presetEditBorder.g) + "," +
    String(presetEditBorder.b);

  mqttClient.publish(
    MQTT_PRESET_BORDER_COLOR_STATE,
    borderColor.c_str(),
    true
  );

  mqttClient.publish(
    "office/sign/preset/state/border_color_power",
    "ON",
    true
  );

  // Background color
  String backgroundColor =
    String(presetEditBackground.r) + "," +
    String(presetEditBackground.g) + "," +
    String(presetEditBackground.b);

  mqttClient.publish(
    MQTT_PRESET_BACKGROUND_COLOR_STATE,
    backgroundColor.c_str(),
    true
  );

  mqttClient.publish(
    "office/sign/preset/state/background_color_power",
    "ON",
    true
  );

}

int findStatusPreset(String name) {

  name.trim();
  name.toUpperCase();

  for (uint8_t i = 0; i < STATUS_PRESET_COUNT; i++) {

    if (name == statusPresets[i].name) {
      return i;
    }
  }

  return -1;
}

bool applyStatusPreset(String message) {

  int presetIndex = findStatusPreset(message);

  if (presetIndex < 0) {
    return false;
  }

  StatusPreset &preset = statusPresets[presetIndex];

  textRed   = preset.text.r;
  textGreen = preset.text.g;
  textBlue  = preset.text.b;

  borderRed   = preset.border.r;
  borderGreen = preset.border.g;
  borderBlue  = preset.border.b;

  backgroundRed   = preset.background.r;
  backgroundGreen = preset.background.g;
  backgroundBlue  = preset.background.b;

  return true;
}

void applyManualColors() {

  textRed   = manualTextRed;
