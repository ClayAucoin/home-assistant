    statusPresets[i].text.r = preferences.getUChar(
      (prefix + "tr").c_str(),
      statusPresets[i].text.r
    );

    statusPresets[i].text.g = preferences.getUChar(
      (prefix + "tg").c_str(),
      statusPresets[i].text.g
    );

    statusPresets[i].text.b = preferences.getUChar(
      (prefix + "tb").c_str(),
      statusPresets[i].text.b
    );

    statusPresets[i].border.r = preferences.getUChar(
      (prefix + "br").c_str(),
      statusPresets[i].border.r
    );

    statusPresets[i].border.g = preferences.getUChar(
      (prefix + "bg").c_str(),
      statusPresets[i].border.g
    );

    statusPresets[i].border.b = preferences.getUChar(
      (prefix + "bb").c_str(),
      statusPresets[i].border.b
    );

    statusPresets[i].background.r = preferences.getUChar(
      (prefix + "gr").c_str(),
      statusPresets[i].background.r
    );

    statusPresets[i].background.g = preferences.getUChar(
      (prefix + "gg").c_str(),
      statusPresets[i].background.g
    );

    statusPresets[i].background.b = preferences.getUChar(
      (prefix + "gb").c_str(),
      statusPresets[i].background.b
    );
  }

  preferences.end();

  // Defensive limits in case stored data is ever invalid.
  borderWidth = constrain(borderWidth, 0, 15);
  scrollSpeed = constrain(scrollSpeed, 1, 10);

  scrollInterval = map(
    scrollSpeed,
    1,
    10,
    150,
    20
  );

  if (
    displayMode != "AUTO" &&
    displayMode != "SINGLE" &&
    displayMode != "TWO LINE" &&
    displayMode != "SCROLL"
  ) {
    displayMode = "AUTO";
  }

  if (
    textAlignment != "LEFT" &&
    textAlignment != "CENTER" &&
    textAlignment != "RIGHT"
  ) {
    textAlignment = "CENTER";
  }

  Serial.println("Settings loaded from NVS");
}

void setupOTA() {

  ArduinoOTA.setHostname(DEVICE_NAME);
  ArduinoOTA.setPassword("office_sign");

  // ==========================================================
  // OTA START
  // ==========================================================

  ArduinoOTA.onStart([]() {

    Serial.println();
    Serial.println("OTA update starting...");

    display->clearScreen();
    display->setTextWrap(false);

    // Cyan
    display->setTextColor(
      display->color565(0, 255, 255)
    );

    // --------------------------------------------------------
    // UPDATE
    // --------------------------------------------------------

    display->setTextSize(1);

    String updateText = "UPDATE";

    int updateWidth = updateText.length() * 6;
    int updateX = (PANEL_RES_X - updateWidth) / 2;

    display->setCursor(updateX, 7);
    display->print(updateText);

    // --------------------------------------------------------
    // Firmware version
    // --------------------------------------------------------

    String versionText = FIRMWARE_VERSION;

    int versionWidth = versionText.length() * 6;
    int versionX = (PANEL_RES_X - versionWidth) / 2;

    display->setCursor(versionX, 19);
    display->print(versionText);
  });

  // ==========================================================
  // OTA COMPLETE
  // ==========================================================

  ArduinoOTA.onEnd([]() {

    Serial.println();
    Serial.println("OTA update complete!");
  });

  // ==========================================================
  // OTA PROGRESS
  // ==========================================================

  ArduinoOTA.onProgress(
    [](unsigned int progress, unsigned int total) {

      static int lastPercent = -1;

      int percent =
        (progress * 100) / total;

      if (
        percent != lastPercent &&
        percent % 10 == 0
      ) {

        Serial.printf(
          "OTA Progress: %u%%\n",
          percent
        );

        lastPercent = percent;
      }
    }
  );

  // ==========================================================
  // OTA ERROR
  // ==========================================================

  ArduinoOTA.onError([](ota_error_t error) {

    Serial.printf(
      "OTA Error [%u]: ",
      error
    );

    if (error == OTA_AUTH_ERROR) {
      Serial.println("Auth Failed");
    }
    else if (error == OTA_BEGIN_ERROR) {
      Serial.println("Begin Failed");
    }
    else if (error == OTA_CONNECT_ERROR) {
      Serial.println("Connect Failed");
    }
    else if (error == OTA_RECEIVE_ERROR) {
      Serial.println("Receive Failed");
    }
    else if (error == OTA_END_ERROR) {
      Serial.println("End Failed");
    }
    else {
      Serial.println("Unknown");
    }

    // Show the error on the matrix.
    display->clearScreen();
    display->setTextWrap(false);
    display->setTextSize(1);

    // Red
    display->setTextColor(
      display->color565(255, 0, 0)
    );

    String errorText = "ERR ";
    errorText += String((int)error);

    int errorWidth = errorText.length() * 6;
    int errorX = (PANEL_RES_X - errorWidth) / 2;

    display->setCursor(errorX, 12);
    display->print(errorText);
  });

  // ==========================================================
  // START OTA SERVICE
  // ==========================================================

  ArduinoOTA.begin();

  Serial.println("OTA ready.");
}

void markSettingsChanged() {
  settingsDirty = true;
  settingsChangedTime = millis();

  Serial.println("Settings marked as changed");
}

void saveSettings() {

  preferences.begin("office-sign", false);

  preferences.putUChar("brightness", signBrightness);
  preferences.putUChar("borderWidth", borderWidth);
  preferences.putUChar("scrollSpeed", scrollSpeed);

  preferences.putBool("displayPower", displayPower);

  preferences.putUChar("textR", manualTextRed);
  preferences.putUChar("textG", manualTextGreen);
  preferences.putUChar("textB", manualTextBlue);

  preferences.putUChar("borderR", manualBorderRed);
  preferences.putUChar("borderG", manualBorderGreen);
  preferences.putUChar("borderB", manualBorderBlue);

  preferences.putUChar("bgR", manualBackgroundRed);
  preferences.putUChar("bgG", manualBackgroundGreen);
  preferences.putUChar("bgB", manualBackgroundBlue);

  preferences.putString("displayMode", displayMode);
  preferences.putString("alignment", textAlignment);
  preferences.putString("message", currentMessage);

  for (uint8_t i = 0; i < STATUS_PRESET_COUNT; i++) {

    String prefix = "p" + String(i);

    preferences.putUChar((prefix + "tr").c_str(), statusPresets[i].text.r);
    preferences.putUChar((prefix + "tg").c_str(), statusPresets[i].text.g);
    preferences.putUChar((prefix + "tb").c_str(), statusPresets[i].text.b);

    preferences.putUChar((prefix + "br").c_str(), statusPresets[i].border.r);
    preferences.putUChar((prefix + "bg").c_str(), statusPresets[i].border.g);
    preferences.putUChar((prefix + "bb").c_str(), statusPresets[i].border.b);

    preferences.putUChar((prefix + "gr").c_str(), statusPresets[i].background.r);
    preferences.putUChar((prefix + "gg").c_str(), statusPresets[i].background.g);
    preferences.putUChar((prefix + "gb").c_str(), statusPresets[i].background.b);
  }

  preferences.end();

  settingsDirty = false;

  Serial.println("Settings saved to NVS");
}

// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);
  loadSettings();

  // Initialize the preset editor from the actual preset values
  // loaded from NVS rather than only the factory defaults.
  loadPresetIntoEditor(0);

  delay(500);

  Serial.println();
  Serial.println("==============================");
  Serial.println("Office Sign");
  Serial.print("Firmware: ");
  Serial.println(FIRMWARE_VERSION);
  Serial.println("==============================");

  // ----------------------------------------------------------
  // Matrix
  // ----------------------------------------------------------

  HUB75_I2S_CFG mxconfig(
    PANEL_RES_X,
    PANEL_RES_Y,
    PANEL_CHAIN
  );

  mxconfig.gpio.r1  = R1_PIN;
  mxconfig.gpio.g1  = G1_PIN;
  mxconfig.gpio.b1  = B1_PIN;

  mxconfig.gpio.r2  = R2_PIN;
  mxconfig.gpio.g2  = G2_PIN;
  mxconfig.gpio.b2  = B2_PIN;

  mxconfig.gpio.a   = A_PIN;
  mxconfig.gpio.b   = B_PIN;
  mxconfig.gpio.c   = C_PIN;
  mxconfig.gpio.d   = D_PIN;
  mxconfig.gpio.e   = E_PIN;

  mxconfig.gpio.lat = LAT_PIN;
  mxconfig.gpio.oe  = OE_PIN;
  mxconfig.gpio.clk = CLK_PIN;

  display =
    new MatrixPanel_I2S_DMA(mxconfig);

  if (!display->begin()) {

    Serial.println(
      "Matrix initialization failed!"
    );

    while (true) {
      delay(1000);
    }
  }

  display->setBrightness8(signBrightness);

  String savedMessage = currentMessage;

  showMessage("BOOT");

  // ----------------------------------------------------------
  // Wi-Fi
  // ----------------------------------------------------------

  startWiFi();

  unsigned long wifiStart = millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - wifiStart < 15000
  ) {

    ArduinoOTA.handle();
    delay(100);
  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("Wi-Fi connected!");

    Serial.print("IP address: ");
    Serial.println(WiFi.localIP());

    Serial.print("RSSI: ");
    Serial.print(WiFi.RSSI());
    Serial.println(" dBm");
  }
  else {
    Serial.println("Initial Wi-Fi connection timed out.");
    Serial.println("Will continue retrying in background.");
  }

  // ----------------------------------------------------------
  // OTA
  // ----------------------------------------------------------

  setupOTA();

  // ----------------------------------------------------------
  // MQTT
  // ----------------------------------------------------------

  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
  mqttClient.setCallback(mqttCallback);

  showMessage(savedMessage);

  connectMQTT();
}

// ============================================================
// LOOP
// ============================================================

void loop() {

  // OTA must remain responsive.
  ArduinoOTA.handle();
  mqttClient.loop();

  // Neither of these functions blocks.
  maintainWiFi();
  maintainMQTT();

  if (scrolling && displayPower) {

    unsigned long now = millis();

    if (now - lastScrollTime >= scrollInterval) {

      lastScrollTime = now;

      scrollX--;

      // Once the entire message has left the display,
      // start again from the right.
      if (scrollX < -scrollTextWidth) {
        scrollX = 61;
      }

      drawScrollFrame();
    }
  }

  // Publish diagnostics every minute.
  if (
    mqttClient.connected() &&
    millis() - lastDiagnosticsUpdate >=
      DIAGNOSTIC_INTERVAL
  ) {

    publishDiagnostics();

    lastDiagnosticsUpdate = millis();
  }

  if (
    settingsDirty &&
    millis() - settingsChangedTime >= SETTINGS_SAVE_DELAY
  ) {
    saveSettings();
  }

  delay(2);
}



