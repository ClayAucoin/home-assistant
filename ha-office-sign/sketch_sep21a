void drawBackground() {

  uint16_t color = display->color565(
    backgroundRed,
    backgroundGreen,
    backgroundBlue
  );

  display->fillScreen(color);
}

void drawBorder() {

  if (borderWidth == 0) {
    return;
  }

  // Prevent impossible widths.
  uint8_t width = constrain(
    borderWidth,
    0,
    15
  );

  uint16_t color = display->color565(
    borderRed,
    borderGreen,
    borderBlue
  );

  // ----------------------------------------------------------
  // TOP AND BOTTOM
  // ----------------------------------------------------------

  display->fillRect(
    0,
    0,
    PANEL_RES_X,
    width,
    color
  );

  display->fillRect(
    0,
    PANEL_RES_Y - width,
    PANEL_RES_X,
    width,
    color
  );

  // ----------------------------------------------------------
  // LEFT PHYSICAL EDGE
  //
  // Because of the panel's one-column horizontal wrap:
  //
  // logical 1 -> physical 0
  // logical 2 -> physical 1
  // logical 3 -> physical 2
  // etc.
  // ----------------------------------------------------------

  display->fillRect(
    1,
    width,
    width,
    PANEL_RES_Y - (width * 2),
    color
  );

  // ----------------------------------------------------------
  // RIGHT PHYSICAL EDGE
  //
  // Physical rightmost column is logical 0.
  // Additional columns extend left from logical 63.
  // ----------------------------------------------------------

  if (width > 1) {

    display->fillRect(
      PANEL_RES_X - (width - 1),
      width,
      width - 1,
      PANEL_RES_Y - (width * 2),
      color
    );
  }

  // Wrapped final physical column.
  display->fillRect(
    0,
    width,
    1,
    PANEL_RES_Y - (width * 2),
    color
  );
}

void drawScrollFrame() {

  drawBackground();

  display->setFont();
  display->setTextWrap(false);
  display->setTextSize(1);

  display->setTextColor(
    display->color565(
      textRed,
      textGreen,
      textBlue
    )
  );

  // Draw scrolling text first.
  display->setCursor(scrollX, 12);
  display->print(scrollMessage);

  // Draw border last so scrolling text
  // disappears behind it.
  drawBorder();
}

void showMessage(String message, bool updateCurrent = true) {

  message.trim();
  message.toUpperCase();

  if (message.length() == 0) {
    return;
  }

  if (updateCurrent) {
    currentMessage = message;
  }

  // If a render preset was explicitly selected, use its colors
  // regardless of the actual message text.
  if (renderPreset.length() > 0) {

    if (!applyStatusPreset(renderPreset)) {
      applyManualColors();
    }

  } else {

    // Normal behavior:
  // A message matching a preset uses that preset.
  // Everything else uses the manual/custom colors.
    if (!applyStatusPreset(message)) {
      applyManualColors();
    }
  }

  if (!displayPower) {

    scrolling = false;
    scrollMessage = "";

    display->clearScreen();

    return;
  }

  // Stop any previous scrolling message.
  scrolling = false;
  scrollMessage = "";

  // --------------------------------------------------
  // FORCED SCROLL MODE
  // --------------------------------------------------
  if (displayMode == "SCROLL") {

    scrollMessage = message;

    // Default font is 6 pixels wide per character.
    scrollTextWidth =
      ((int)message.length() * 6) - 1;

    // Start just inside the right side of the display.
    scrollX = 61;

    lastScrollTime = millis();
    scrolling = true;

    drawScrollFrame();

    return;
  }

  // --------------------------------------------------
  // FORCED SINGLE-LINE MODE
  // --------------------------------------------------
  if (displayMode == "SINGLE") {

    drawBackground();

    int textSize = 1;
    int width = ((int)message.length() * 6) - 1;

    // Use size 2 if the message fits.
    int largeWidth =
      ((int)message.length() * 12) - 2;

    if (largeWidth <= 58) {
      textSize = 2;
      width = largeWidth;
    }

    // If it will not fit at size 1,
    // keep it on one line and scroll it.
    if (width > 58) {

      scrollMessage = message;
      scrollTextWidth = width;
      scrollX = 61;

      lastScrollTime = millis();
      scrolling = true;

      drawScrollFrame();

      return;
    }

    display->setTextSize(textSize);
    display->setTextColor(
      display->color565(
        textRed,
        textGreen,
        textBlue
      )
    );

    int x = getAlignedX(width);

    // Vertically center the built-in font.
    int textHeight = 8 * textSize;
    int y = (32 - textHeight) / 2;

    display->setCursor(x, y);
    display->print(message);

    // Draw border last so text cannot overwrite it.
    drawBorder();

    return;
  }

  // --------------------------------------------------
  // FORCED TWO-LINE MODE
  // --------------------------------------------------
  if (displayMode == "TWO LINE") {

    drawBackground();

    // Find the best space at which to split the message.
    int bestSplit = -1;
    int bestDifference = 9999;

    for (int i = 0; i < (int)message.length(); i++) {

      if (message.charAt(i) == ' ') {

        String line1 = message.substring(0, i);
        String line2 = message.substring(i + 1);

        line1.trim();
        line2.trim();

        if (line1.length() == 0 || line2.length() == 0) {
          continue;
        }

        int width1 =
          ((int)line1.length() * 6) - 1;

        int width2 =
          ((int)line2.length() * 6) - 1;

        // Both lines must fit inside the usable width.
        if (width1 <= 58 && width2 <= 58) {

          int difference = abs(width1 - width2);

          if (difference < bestDifference) {
            bestDifference = difference;
            bestSplit = i;
          }
        }
      }
    }

    // We found a usable two-line split.
    if (bestSplit >= 0) {

      String line1 =
        message.substring(0, bestSplit);

      String line2 =
        message.substring(bestSplit + 1);

      line1.trim();
      line2.trim();

      int width1 =
        ((int)line1.length() * 6) - 1;

      int width2 =
        ((int)line2.length() * 6) - 1;

      display->setTextSize(1);

      display->setTextColor(
        display->color565(
          textRed,
          textGreen,
          textBlue
        )
      );

      // First line
      int x1 = getAlignedX(width1);

      display->setCursor(
        x1,
        7
      );

      display->print(line1);

      // Second line
      int x2 = getAlignedX(width2);

      display->setCursor(
        x2,
        18
      );

      display->print(line2);

      drawBorder();

      return;
    }

    // No valid two-line split was possible.
    // Keep a single word centered if it fits.
    int width =
      ((int)message.length() * 6) - 1;

    if (width <= 58) {

      display->setTextSize(1);

      display->setTextColor(
        display->color565(
          textRed,
          textGreen,
          textBlue
        )
      );

      int x = getAlignedX(width);

      display->setCursor(
        x,
        12
      );

      display->print(message);

      drawBorder();

      return;
    }

    // It cannot be split and cannot fit.
    // Fall back to scrolling.
    scrollMessage = message;
    scrollTextWidth = width;
    scrollX = 61;

    lastScrollTime = millis();
    scrolling = true;

    drawScrollFrame();

    return;
  }


  drawBackground();
  drawBorder();

  display->setFont();
  display->setTextWrap(false);

  display->setTextColor(
    display->color565(
      textRed,
      textGreen,
      textBlue
    )
  );

  // ----------------------------------------------------------
  // PANEL GEOMETRY
  // ----------------------------------------------------------

  const int contentLeft  = 4;
  const int contentRight = 61;
  const int contentWidth = 58;

  // Require at least a little breathing room for small
  // single-line text rather than filling all 58 pixels.
  const int singleLineMaxWidth = 54;

  // ----------------------------------------------------------
  // HELPER: built-in font width
  // ----------------------------------------------------------

  auto textWidth = [](String text, int size) {

    if (text.length() == 0) {
      return 0;
    }

    return ((int)text.length() * 6 * size) - size;
  };

  // ----------------------------------------------------------
  // EXPLICIT TWO-LINE MESSAGE
  // ----------------------------------------------------------

  int newlinePos = message.indexOf('\n');

  if (newlinePos >= 0) {

    String line1 = message.substring(0, newlinePos);
    String line2 = message.substring(newlinePos + 1);

    line1.trim();
    line2.trim();

    if (line1.length() > 0 && line2.length() > 0) {

      int width1 = textWidth(line1, 1);
      int width2 = textWidth(line2, 1);

      // Respect an intentional newline when both lines fit.
      if (width1 <= contentWidth && width2 <= contentWidth) {

        display->setTextSize(1);

        int x1 = getAlignedX(width1);
        int x2 = getAlignedX(width2);

        display->setCursor(x1, 7);
        display->print(line1);

        display->setCursor(x2, 18);
        display->print(line2);

        // Draw border last so text cannot overwrite it.
        drawBorder();

        return;
      }
    }
  }

  // ----------------------------------------------------------
  // 1. TRY LARGE SINGLE LINE
  // ----------------------------------------------------------

  int largeWidth = textWidth(message, 2);

  if (largeWidth <= contentWidth) {

    display->setTextSize(2);

    int x = getAlignedX(largeWidth);

    display->setCursor(x, 9);
    display->print(message);

    return;
  }

  // ----------------------------------------------------------
  // 2. TRY SMALL SINGLE LINE
  // ----------------------------------------------------------

  int smallWidth = textWidth(message, 1);

  if (smallWidth <= singleLineMaxWidth) {

    display->setTextSize(1);

    int x = getAlignedX(smallWidth);

    display->setCursor(x, 12);
    display->print(message);

    return;
  }

  // ----------------------------------------------------------
  // 3. FIND BEST TWO-LINE SPLIT
  // ----------------------------------------------------------

  String line1 = "";
  String line2 = "";

  int bestDifference = 9999;

  for (int i = 0; i < message.length(); i++) {

    if (message.charAt(i) != ' ') {
      continue;
    }

    String candidate1 =
      message.substring(0, i);

    String candidate2 =
      message.substring(i + 1);

    candidate1.trim();
    candidate2.trim();

    int width1 = textWidth(candidate1, 1);
    int width2 = textWidth(candidate2, 1);

    // Both lines must fit our content area.
    if (
      width1 <= contentWidth &&
      width2 <= contentWidth
    ) {

      // Prefer the split that produces the
      // most evenly sized two lines.
      int difference =
        abs(width1 - width2);

      if (difference < bestDifference) {

        bestDifference = difference;

        line1 = candidate1;
        line2 = candidate2;
      }
    }
  }

  // ----------------------------------------------------------
  // 4. DISPLAY TWO LINES
  // ----------------------------------------------------------

  if (
    line1.length() > 0 &&
    line2.length() > 0
  ) {

    display->setTextSize(1);

    int width1 = textWidth(line1, 1);
    int width2 = textWidth(line2, 1);

    int x1 = getAlignedX(width1);
    int x2 = getAlignedX(width2);

    display->setCursor(x1, 7);
    display->print(line1);

    display->setCursor(x2, 18);
    display->print(line2);

    return;
  }

  // ----------------------------------------------------------
  // 5. SCROLLING FALLBACK
  // ----------------------------------------------------------

  scrollMessage = message;
  scrollTextWidth = textWidth(message, 1);

  // Start at the right side of our content area.
  scrollX = 61;

  lastScrollTime = millis();
  scrolling = true;

  drawScrollFrame();
}

void redrawCurrentDisplay() {

  // If a temporary rendered message is active,
  // redraw that without replacing the normal message.
  if (renderMessage.length() > 0) {

    showMessage(renderMessage, false);

    return;
  }

  // Otherwise redraw the normal persistent message.
  showMessage(currentMessage, false);
}

// --------------------------------------------------
// TEXT ALIGNMENT
// --------------------------------------------------

int getAlignedX(int textWidth) {

  // Physical content boundaries after accounting
  // for the panel's one-column horizontal wrap.
  //
  // borderWidth 2:
  // logical 1-2  = left border
  // logical 3    = padding
  // logical 4-61 = content
  // logical 62   = padding
  // logical 63,0 = right border

  int leftX;
  int rightX;

  if (borderWidth > 0) {

    leftX = borderWidth + 2;
    rightX = PANEL_RES_X - borderWidth - 1;

  } else {

    // No border. Preserve one pixel of breathing room.
    leftX = 1;
    rightX = PANEL_RES_X - 2;
  }

  int availableWidth =
    rightX - leftX + 1;

  if (textAlignment == "LEFT") {
    return leftX;
  }

  if (textAlignment == "RIGHT") {
    return rightX - textWidth + 1;
  }

  // CENTER
  return leftX +
    ((availableWidth - textWidth) / 2);
}

