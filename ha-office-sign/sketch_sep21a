        colorState.c_str(),
        true
      );

      Serial.print("Background color set to: ");
      Serial.println(colorState);
    }
  }


  // ==========================================================
  // BACKGROUND COLOR POWER
  // ==========================================================

  if (String(topic) == MQTT_BACKGROUND_COLOR_POWER_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (message == "OFF") {

      backgroundRed = 0;
      backgroundGreen = 0;
      backgroundBlue = 0;

      manualBackgroundRed = 0;
      manualBackgroundGreen = 0;
      manualBackgroundBlue = 0;

      markSettingsChanged();

      redrawCurrentDisplay();

      mqttClient.publish(
        MQTT_BACKGROUND_COLOR_STATE,
        "0,0,0",
        true
      );

      Serial.println(
        "Background color set to black"
      );
    }
  }


  // ==========================================================
  // TEXT COLOR POWER
  // ==========================================================

  if (String(topic) == MQTT_TEXT_COLOR_POWER_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (message == "OFF") {

      textRed = 0;
      textGreen = 0;
      textBlue = 0;

      manualTextRed = 0;
      manualTextGreen = 0;
      manualTextBlue = 0;

      markSettingsChanged();

      redrawCurrentDisplay();

      mqttClient.publish(
        MQTT_TEXT_COLOR_STATE,
        "0,0,0",
        true
      );

      Serial.println(
        "Text color set to black"
      );
    }
  }


  // ==========================================================
  // BORDER COLOR POWER
  // ==========================================================

  if (String(topic) == MQTT_BORDER_COLOR_POWER_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (message == "OFF") {

      borderRed = 0;
      borderGreen = 0;
      borderBlue = 0;

      manualBorderRed = 0;
      manualBorderGreen = 0;
      manualBorderBlue = 0;

      markSettingsChanged();

      redrawCurrentDisplay();

      mqttClient.publish(
        MQTT_BORDER_COLOR_STATE,
        "0,0,0",
        true
      );

      Serial.println(
        "Border color set to black"
      );
    }
  }


  // ==========================================================
  // SCROLL SPEED
  // ==========================================================

  if (String(topic) == MQTT_SCROLL_SPEED_TOPIC) {

    int newSpeed = message.toInt();

    newSpeed = constrain(
      newSpeed,
      1,
      10
    );

    scrollSpeed = newSpeed;

    markSettingsChanged();

    scrollInterval = map(
      scrollSpeed,
      1,
      10,
      150,
      20
    );

    String speedState =
      String(scrollSpeed);

    mqttClient.publish(
      MQTT_SCROLL_SPEED_STATE,
      speedState.c_str(),
      true
    );

    Serial.print("Scroll speed set to: ");
    Serial.print(scrollSpeed);

    Serial.print(" (");
    Serial.print(scrollInterval);
    Serial.println(" ms)");
  }


  // ==========================================================
  // DISPLAY MODE
  // ==========================================================

  if (String(topic) == MQTT_DISPLAY_MODE_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (
      message == "AUTO" ||
      message == "SINGLE" ||
      message == "TWO LINE" ||
      message == "SCROLL"
    ) {

      displayMode = message;

      markSettingsChanged();

      mqttClient.publish(
        MQTT_DISPLAY_MODE_STATE,
        displayMode.c_str(),
        true
      );

      Serial.print("Display mode set to: ");
      Serial.println(displayMode);

      redrawCurrentDisplay();
    }
  }


  // ==========================================================
  // TEXT ALIGNMENT
  // ==========================================================

  if (String(topic) == MQTT_TEXT_ALIGNMENT_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (
      message == "LEFT" ||
      message == "CENTER" ||
      message == "RIGHT"
    ) {

      textAlignment = message;

      markSettingsChanged();

      mqttClient.publish(
        MQTT_TEXT_ALIGNMENT_STATE,
        textAlignment.c_str(),
        true
      );

      Serial.print("Text alignment set to: ");
      Serial.println(textAlignment);

      redrawCurrentDisplay();
    }
  }


  // ==========================================================
  // PRESET EDITOR SELECT
  // ==========================================================

  if (String(topic) == MQTT_PRESET_SELECT_TOPIC) {

    message.trim();
    message.toUpperCase();

    int presetIndex =
      findStatusPreset(message);

    if (presetIndex >= 0) {

      loadPresetIntoEditor(
        (uint8_t)presetIndex
      );

      publishPresetEditorState();

      Serial.print(
        "Preset editor selected: "
      );

      Serial.println(
        statusPresets[presetEditIndex].name
      );
    }
  }


  // ==========================================================
  // PRESET EDITOR TEXT COLOR
  // ==========================================================

  if (String(topic) == MQTT_PRESET_TEXT_COLOR_TOPIC) {

    int firstComma = message.indexOf(',');
    int secondComma =
      message.indexOf(',', firstComma + 1);

    if (
      firstComma > 0 &&
      secondComma > firstComma
    ) {

      int red =
        message.substring(
          0,
          firstComma
        ).toInt();

      int green =
        message.substring(
          firstComma + 1,
          secondComma
        ).toInt();

      int blue =
        message.substring(
          secondComma + 1
        ).toInt();

      presetEditText.r =
        constrain(red, 0, 255);

      presetEditText.g =
        constrain(green, 0, 255);

      presetEditText.b =
        constrain(blue, 0, 255);

      publishPresetEditorState();

      Serial.print(
        "Preset editor text color: "
      );

      Serial.print(presetEditText.r);
      Serial.print(",");
      Serial.print(presetEditText.g);
      Serial.print(",");
      Serial.println(presetEditText.b);
    }
  }


  // ==========================================================
  // PRESET EDITOR BORDER COLOR
  // ==========================================================

  if (String(topic) == MQTT_PRESET_BORDER_COLOR_TOPIC) {

    int firstComma = message.indexOf(',');
    int secondComma =
      message.indexOf(',', firstComma + 1);

    if (
      firstComma > 0 &&
      secondComma > firstComma
    ) {

      int red =
        message.substring(
          0,
          firstComma
        ).toInt();

      int green =
        message.substring(
          firstComma + 1,
          secondComma
        ).toInt();

      int blue =
        message.substring(
          secondComma + 1
        ).toInt();

      presetEditBorder.r =
        constrain(red, 0, 255);

      presetEditBorder.g =
        constrain(green, 0, 255);

      presetEditBorder.b =
        constrain(blue, 0, 255);

      publishPresetEditorState();

      Serial.print(
        "Preset editor border color: "
      );

      Serial.print(presetEditBorder.r);
      Serial.print(",");
      Serial.print(presetEditBorder.g);
      Serial.print(",");
      Serial.println(presetEditBorder.b);
    }
  }


  // ==========================================================
  // PRESET EDITOR BACKGROUND COLOR
  // ==========================================================

  if (String(topic) == MQTT_PRESET_BACKGROUND_COLOR_TOPIC) {

    int firstComma = message.indexOf(',');
    int secondComma =
      message.indexOf(',', firstComma + 1);

    if (
      firstComma > 0 &&
      secondComma > firstComma
    ) {

      int red =
        message.substring(
          0,
          firstComma
        ).toInt();

      int green =
        message.substring(
          firstComma + 1,
          secondComma
        ).toInt();

      int blue =
        message.substring(
          secondComma + 1
        ).toInt();

      presetEditBackground.r =
        constrain(red, 0, 255);

      presetEditBackground.g =
        constrain(green, 0, 255);

      presetEditBackground.b =
        constrain(blue, 0, 255);

      publishPresetEditorState();

      Serial.print(
        "Preset editor background color: "
      );

      Serial.print(presetEditBackground.r);
      Serial.print(",");
      Serial.print(presetEditBackground.g);
      Serial.print(",");
      Serial.println(presetEditBackground.b);
    }
  }


  // ==========================================================
  // PRESET EDITOR SAVE
  // ==========================================================

  if (String(topic) == MQTT_PRESET_SAVE_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (message == "SAVE") {

      StatusPreset &preset =
        statusPresets[presetEditIndex];

      preset.text =
        presetEditText;

      preset.border =
        presetEditBorder;

      preset.background =
        presetEditBackground;

      markSettingsChanged();

      publishPresetEditorState();

      Serial.print("Preset saved: ");
      Serial.println(preset.name);
    }
  }


  // ==========================================================
  // DISPLAY POWER
  // ==========================================================

  if (String(topic) == MQTT_DISPLAY_POWER_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (message == "ON") {

      displayPower = true;

      markSettingsChanged();

      // Restore whichever message currently owns the display:
      // temporary render first, otherwise persistent message.
      redrawCurrentDisplay();

      mqttClient.publish(
        MQTT_DISPLAY_POWER_STATE,
        "ON",
        true
      );

      Serial.println(
        "Display power: ON"
      );
    }

    else if (message == "OFF") {

      displayPower = false;

      markSettingsChanged();

      scrolling = false;
      scrollMessage = "";

      display->clearScreen();

      mqttClient.publish(
        MQTT_DISPLAY_POWER_STATE,
        "OFF",
        true
      );

      Serial.println(
        "Display power: OFF"
      );
    }
  }


  // ==========================================================
  // TEMPORARY RENDER PRESET
  // ==========================================================

  if (String(topic) == MQTT_RENDER_PRESET_TOPIC) {

    message.trim();
    message.toUpperCase();

    if (
      message.length() == 0 ||
      message == "NONE"
    ) {

      renderPreset = "";

      Serial.println(
        "Render preset cleared"
      );
    }

    else {

      int presetIndex =
        findStatusPreset(message);

      if (presetIndex >= 0) {

        renderPreset =
          statusPresets[presetIndex].name;

        Serial.print(
          "Render preset set to: "
        );

        Serial.println(renderPreset);
      }

      else {

        Serial.print(
          "Unknown render preset: "
        );

        Serial.println(message);
      }
    }
  }


  // ==========================================================
  // TEMPORARY RENDER MESSAGE
  // ==========================================================

  if (String(topic) == MQTT_RENDER_MESSAGE_TOPIC) {

    message.trim();

    if (message.length() > 0) {

      // Store temporary display text separately from the
      // persistent/manual message.
      renderMessage = message;

      // Render it without replacing currentMessage.
      showMessage(
        renderMessage,
        false
      );

      // Immediately report what is actually on the sign.
      mqttClient.publish(
        MQTT_MESSAGE_STATE,
        renderMessage.c_str(),
        true
      );

      Serial.print(
        "Rendered message using preset: "
      );

      if (renderPreset.length() > 0) {
        Serial.println(renderPreset);
      }
      else {
        Serial.println("NONE");
      }
    }

    else {

      // Empty payload releases temporary rendering and
      // restores the persistent/manual message.
      renderMessage = "";
      renderPreset = "";

      showMessage(
        currentMessage,
        false
      );

      mqttClient.publish(
        MQTT_MESSAGE_STATE,
        currentMessage.c_str(),
        true
      );

      Serial.println(
        "Temporary render cleared; normal message restored"
      );
    }
  }


  // ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑
  // ADD NEW MQTT CALLBACK HANDLERS ABOVE HERE
}

// ============================================================
// WI-FI
// ============================================================

void startWiFi() {

  Serial.print("Connecting to Wi-Fi: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.setHostname(DEVICE_NAME);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  lastWiFiAttempt = millis();
}

void maintainWiFi() {

  if (WiFi.status() == WL_CONNECTED) {
    return;
  }

  if (
    millis() - lastWiFiAttempt >=
    WIFI_RETRY_INTERVAL
  ) {

    Serial.println("Wi-Fi disconnected. Reconnecting...");

    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    lastWiFiAttempt = millis();
  }
}

// ============================================================
// MQTT
// ============================================================

void connectMQTT() {

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  if (mqttClient.connected()) {
    return;
  }

  Serial.print("Connecting to MQTT...");

  String clientId = "office-sign-";
  clientId += String(
    (uint32_t)ESP.getEfuseMac(),
    HEX
  );

  if (
    mqttClient.connect(
      clientId.c_str(),
      MQTT_USER,
      MQTT_PASSWORD,
      MQTT_STATUS_TOPIC,
      0,
      true,
      "offline"
    )
  ) {

    Serial.println("connected!");

    mqttClient.publish(
      MQTT_STATUS_TOPIC,
      "online",
      true
    );

    mqttClient.subscribe(MQTT_MESSAGE_TOPIC);
    mqttClient.subscribe(MQTT_BRIGHTNESS_TOPIC);
    mqttClient.subscribe(MQTT_TEXT_COLOR_TOPIC);
    mqttClient.subscribe(MQTT_BORDER_COLOR_TOPIC);
    mqttClient.subscribe(MQTT_BORDER_WIDTH_TOPIC);
    mqttClient.subscribe(MQTT_BACKGROUND_COLOR_TOPIC);
    mqttClient.subscribe(MQTT_BACKGROUND_COLOR_POWER_TOPIC);
    mqttClient.subscribe(MQTT_TEXT_COLOR_POWER_TOPIC);
    mqttClient.subscribe(MQTT_BORDER_COLOR_POWER_TOPIC);
    mqttClient.subscribe(MQTT_SCROLL_SPEED_TOPIC);
    mqttClient.subscribe(MQTT_DISPLAY_MODE_TOPIC);
    mqttClient.subscribe(MQTT_TEXT_ALIGNMENT_TOPIC);
    mqttClient.subscribe(MQTT_PRESET_SELECT_TOPIC);
    mqttClient.subscribe(MQTT_PRESET_TEXT_COLOR_TOPIC);
    mqttClient.subscribe(MQTT_PRESET_BORDER_COLOR_TOPIC);
    mqttClient.subscribe(MQTT_PRESET_BACKGROUND_COLOR_TOPIC);
    mqttClient.subscribe(MQTT_PRESET_SAVE_TOPIC);
    mqttClient.subscribe(MQTT_DISPLAY_POWER_TOPIC);
    mqttClient.subscribe(MQTT_RENDER_PRESET_TOPIC);
    mqttClient.subscribe(MQTT_RENDER_MESSAGE_TOPIC);

    // ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  
    // CONNECT NEW SUBSCRIPTIONS ABOVE HERE

    Serial.print("Subscribed to: ");
    Serial.println(MQTT_MESSAGE_TOPIC);

    publishDiagnostics();
    publishPresetEditorState();
  }

  else {

    Serial.print("failed, rc=");
    Serial.println(mqttClient.state());
  }

  lastMQTTAttempt = millis();
}

void maintainMQTT() {

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  if (mqttClient.connected()) {
    mqttClient.loop();
    return;
  }

  if (
    millis() - lastMQTTAttempt >=
    MQTT_RETRY_INTERVAL
  ) {

    connectMQTT();
  }
}

