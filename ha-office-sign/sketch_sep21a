void publishDiagnostics() {

  if (!mqttClient.connected()) {
    return;
  }

  mqttClient.publish(
    MQTT_VERSION_TOPIC,
    FIRMWARE_VERSION,
    true
  );

  String ip = WiFi.localIP().toString();

  mqttClient.publish(
    MQTT_IP_TOPIC,
    ip.c_str(),
    true
  );

  String rssi = String(WiFi.RSSI());

  mqttClient.publish(
    MQTT_RSSI_TOPIC,
    rssi.c_str(),
    true
  );

  String uptime = String(millis() / 1000);

  mqttClient.publish(
    MQTT_UPTIME_TOPIC,
    uptime.c_str(),
    true
  );

  // Report the message that is actually being displayed.
  // Temporary render text takes precedence over the normal
  // persistent message.
  String displayedMessage =
    renderMessage.length() > 0
      ? renderMessage
      : currentMessage;

  mqttClient.publish(
    MQTT_MESSAGE_STATE,
    displayedMessage.c_str(),
    true
  );

  String brightnessState =
    String(signBrightness);

  mqttClient.publish(
    MQTT_BRIGHTNESS_STATE,
    brightnessState.c_str(),
    true
  );

  String textColorState =
    String(manualTextRed) + "," +
    String(manualTextGreen) + "," +
    String(manualTextBlue);

  mqttClient.publish(
    MQTT_TEXT_COLOR_STATE,
    textColorState.c_str(),
    true
  );

  String borderColorState =
    String(manualBorderRed) + "," +
    String(manualBorderGreen) + "," +
    String(manualBorderBlue);

  mqttClient.publish(
    MQTT_BORDER_COLOR_STATE,
    borderColorState.c_str(),
    true
  );

  String backgroundColorState =
    String(manualBackgroundRed) + "," +
    String(manualBackgroundGreen) + "," +
    String(manualBackgroundBlue);

  mqttClient.publish(
    MQTT_BACKGROUND_COLOR_STATE,
    backgroundColorState.c_str(),
    true
  );

  String borderWidthState =
    String(borderWidth);

  mqttClient.publish(
    MQTT_BORDER_WIDTH_STATE,
    borderWidthState.c_str(),
    true
  );

  String scrollSpeedState =
    String(scrollSpeed);

  mqttClient.publish(
    MQTT_SCROLL_SPEED_STATE,
    scrollSpeedState.c_str(),
    true
  );

  mqttClient.publish(
    MQTT_DISPLAY_MODE_STATE,
    displayMode.c_str(),
    true
  );

  mqttClient.publish(
    MQTT_TEXT_ALIGNMENT_STATE,
    textAlignment.c_str(),
    true
  );

  mqttClient.publish(
    MQTT_DISPLAY_POWER_STATE,
    displayPower ? "ON" : "OFF",
    true
  );

  // ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑  ↑
  // PUBLISH NEW CURRENT STATES ABOVE HERE
}


// ============================================================
// MQTT CALLBACK
// ============================================================

void mqttCallback(
  char* topic,
  byte* payload,
  unsigned int length
) {

  String message;

  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }

  Serial.print("MQTT [");
  Serial.print(topic);
  Serial.print("]: ");
  Serial.println(message);


  // ==========================================================
  // NORMAL / MANUAL MESSAGE
  // ==========================================================

  if (String(topic) == MQTT_MESSAGE_TOPIC) {

    // A normal message takes control back from temporary
    // calendar/automation rendering.
    renderPreset = "";
    renderMessage = "";

    showMessage(message);

    markSettingsChanged();

    mqttClient.publish(
      MQTT_MESSAGE_STATE,
      currentMessage.c_str(),
      true
    );
  }


  // ==========================================================
  // BRIGHTNESS
  // ==========================================================

  if (String(topic) == MQTT_BRIGHTNESS_TOPIC) {

    int newBrightness = message.toInt();

    newBrightness = constrain(
      newBrightness,
      0,
      255
    );

    signBrightness = newBrightness;

    display->setBrightness8(
      signBrightness
    );

    markSettingsChanged();

    String brightnessState =
      String(signBrightness);

    mqttClient.publish(
      MQTT_BRIGHTNESS_STATE,
      brightnessState.c_str(),
      true
    );

    Serial.print("Brightness set to: ");
    Serial.println(signBrightness);
  }


  // ==========================================================
  // TEXT COLOR
  // ==========================================================

  if (String(topic) == MQTT_TEXT_COLOR_TOPIC) {

    int firstComma = message.indexOf(',');
    int secondComma = message.indexOf(',', firstComma + 1);

    if (
      firstComma > 0 &&
      secondComma > firstComma
    ) {

      int red =
        message.substring(0, firstComma).toInt();

      int green =
        message.substring(
          firstComma + 1,
          secondComma
        ).toInt();

      int blue =
        message.substring(
          secondComma + 1
        ).toInt();

      textRed = constrain(red, 0, 255);
      textGreen = constrain(green, 0, 255);
      textBlue = constrain(blue, 0, 255);

      manualTextRed = textRed;
      manualTextGreen = textGreen;
      manualTextBlue = textBlue;

      markSettingsChanged();

      redrawCurrentDisplay();

      String colorState =
        String(manualTextRed) + "," +
        String(manualTextGreen) + "," +
        String(manualTextBlue);

      mqttClient.publish(
        MQTT_TEXT_COLOR_STATE,
        colorState.c_str(),
        true
      );

      Serial.print("Text color set to: ");
      Serial.println(colorState);
    }
  }


  // ==========================================================
  // BORDER COLOR
  // ==========================================================

  if (String(topic) == MQTT_BORDER_COLOR_TOPIC) {

    int firstComma = message.indexOf(',');
    int secondComma = message.indexOf(',', firstComma + 1);

    if (
      firstComma > 0 &&
      secondComma > firstComma
    ) {

      int red =
        message.substring(0, firstComma).toInt();

      int green =
        message.substring(
          firstComma + 1,
          secondComma
        ).toInt();

      int blue =
        message.substring(
          secondComma + 1
        ).toInt();

      borderRed = constrain(red, 0, 255);
      borderGreen = constrain(green, 0, 255);
      borderBlue = constrain(blue, 0, 255);

      manualBorderRed = borderRed;
      manualBorderGreen = borderGreen;
      manualBorderBlue = borderBlue;

      markSettingsChanged();

      redrawCurrentDisplay();

      String colorState =
        String(manualBorderRed) + "," +
        String(manualBorderGreen) + "," +
        String(manualBorderBlue);

      mqttClient.publish(
        MQTT_BORDER_COLOR_STATE,
        colorState.c_str(),
        true
      );

      Serial.print("Border color set to: ");
      Serial.println(colorState);
    }
  }


  // ==========================================================
  // BORDER WIDTH
  // ==========================================================

  if (String(topic) == MQTT_BORDER_WIDTH_TOPIC) {

    int newWidth = message.toInt();

    newWidth = constrain(
      newWidth,
      0,
      15
    );

    borderWidth = newWidth;

    markSettingsChanged();

    redrawCurrentDisplay();

    String widthState =
      String(borderWidth);

    mqttClient.publish(
      MQTT_BORDER_WIDTH_STATE,
      widthState.c_str(),
      true
    );

    Serial.print("Border width set to: ");
    Serial.println(borderWidth);
  }


  // ==========================================================
  // BACKGROUND COLOR
  // ==========================================================

  if (String(topic) == MQTT_BACKGROUND_COLOR_TOPIC) {

    int firstComma = message.indexOf(',');
    int secondComma = message.indexOf(',', firstComma + 1);

    if (
      firstComma > 0 &&
      secondComma > firstComma
    ) {

      int red =
        message.substring(0, firstComma).toInt();

      int green =
        message.substring(
          firstComma + 1,
          secondComma
        ).toInt();

      int blue =
        message.substring(
          secondComma + 1
        ).toInt();

      backgroundRed = constrain(red, 0, 255);
      backgroundGreen = constrain(green, 0, 255);
      backgroundBlue = constrain(blue, 0, 255);

