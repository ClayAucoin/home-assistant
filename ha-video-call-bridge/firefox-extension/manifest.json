{
  "manifest_version": 3,
  "name": "HA Google Meet State Bridge",
  "version": "1.0.0",
  "description": "Reports active Google Meet call state to the local HA Video Call Bridge.",
  "author": "Clay Aucoin",
  "permissions": [],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet_state_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ha-google-meet-state-bridge@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}